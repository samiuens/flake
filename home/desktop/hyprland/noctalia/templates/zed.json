{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Noctalia",
  "author": "noctalia-shell",
  "themes": [
    {
      "name": "Noctalia",
      "appearance": "dark",
      "style": {
        "background": "{{colors.surface.default.hex}}",
        "border": "{{colors.surface_container.default.hex}}",
        "border.variant": "{{colors.surface_container.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.primary.default.hex}}",
        "border.transparent": "{{colors.surface_container_lowest.default.hex}}",
        "border.disabled": "{{colors.surface_container.default.hex}}",
        "elevated_surface.background": "{{colors.surface_container_high.default.hex}}",
        "surface.background": "{{colors.surface_container.default.hex}}",
        "element.background": "{{colors.surface_container_low.default.hex}}",
        "element.hover": "{{colors.surface_container.default.hex}}",
        "element.active": "{{colors.surface_container_high.default.hex}}",
        "element.selected": "{{colors.secondary_container.default.hex}}",
        "element.disabled": "{{colors.surface_container_lowest.default.hex}}",
        "drop_target.background": "{{colors.primary_container.default.hex}}",
        "ghost_element.background": "{{colors.surface.default.hex}}",
        "ghost_element.hover": "{{colors.surface_container.default.hex}}",
        "ghost_element.active": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.selected": "{{colors.secondary_container.default.hex}}",
        "ghost_element.disabled": "{{colors.surface.default.hex}}",
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.on_surface_variant.default.hex}}",
        "text.disabled": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface.default.hex}}",
        "icon.muted": "{{colors.on_surface_variant.default.hex}}",
        "icon.disabled": "{{colors.outline.default.hex}}",
        "icon.placeholder": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "status_bar.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.background": "{{colors.surface_container.default.hex}}",
        "title_bar.inactive_background": "{{colors.surface_container_low.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.inactive_background": "{{colors.surface_container_lowest.default.hex}}",
        "tab.active_background": "{{colors.surface.default.hex}}",
        "search.match_background": "{{colors.tertiary_container.default.hex}}",
        "panel.background": "{{colors.surface_container_lowest.default.hex}}",
        "panel.focused_border": "{{colors.primary.default.hex}}",
        "pane.focused_border": "{{colors.primary.default.hex}}",
        "scrollbar.thumb.background": "{{colors.surface_container_high.default.hex}}",
        "scrollbar.thumb.hover_background": "{{colors.surface_container_highest.default.hex}}",
        "scrollbar.thumb.border": "{{colors.outline_variant.default.hex}}",
        "scrollbar.track.background": "{{colors.surface_container_lowest.default.hex}}",
        "scrollbar.track.border": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.background": "{{colors.surface_container_lowest.default.hex}}",
        "editor.gutter.background": "{{colors.surface_container_lowest.default.hex}}",
        "editor.subheader.background": "{{colors.surface_container_low.default.hex}}",
        "editor.active_line.background": "{{colors.surface_container_low.default.hex}}",
        "editor.highlighted_line.background": "{{colors.surface_container.default.hex}}",
        "editor.line_number": "{{colors.on_surface_variant.default.hex}}",
        "editor.active_line_number": "{{colors.primary.default.hex}}",
        "editor.invisible": "{{colors.outline_variant.default.hex}}",
        "editor.wrap_guide": "{{colors.outline_variant.default.hex}}",
        "editor.active_wrap_guide": "{{colors.outline.default.hex}}",
        "editor.document_highlight.read_background": "{{colors.secondary_container.default.hex}}",
        "editor.document_highlight.write_background": "{{colors.tertiary_container.default.hex}}",
        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.bright_foreground": "{{colors.on_surface.default.hex}}",
        "terminal.dim_foreground": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi_black": "{{colors.surface_variant.default.hex}}",
        "terminal.ansi_bright_black": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi_red": "{{colors.error.default.hex}}",
        "terminal.ansi_bright_red": "{{colors.error.default.hex}}",
        "terminal.ansi_green": "{{colors.primary.default.hex}}",
        "terminal.ansi_bright_green": "{{colors.primary.default.hex}}",
        "terminal.ansi_yellow": "{{colors.secondary.default.hex}}",
        "terminal.ansi_bright_yellow": "{{colors.secondary.default.hex}}",
        "terminal.ansi_blue": "{{colors.tertiary.default.hex}}",
        "terminal.ansi_bright_blue": "{{colors.tertiary.default.hex}}",
        "terminal.ansi_magenta": "{{colors.primary_fixed_dim.default.hex}}",
        "terminal.ansi_bright_magenta": "{{colors.primary_fixed_dim.default.hex}}",
        "terminal.ansi_cyan": "{{colors.secondary_fixed_dim.default.hex}}",
        "terminal.ansi_bright_cyan": "{{colors.secondary_fixed_dim.default.hex}}",
        "terminal.ansi_white": "{{colors.on_surface.default.hex}}",
        "terminal.ansi_bright_white": "{{colors.on_surface.default.hex}}",
        "conflict": "{{colors.error.default.hex}}",
        "conflict.background": "{{colors.error_container.default.hex}}",
        "conflict.border": "{{colors.error.default.hex}}",
        "created": "{{colors.primary.default.hex}}",
        "created.background": "{{colors.primary_container.default.hex}}",
        "created.border": "{{colors.primary.default.hex}}",
        "deleted": "{{colors.error.default.hex}}",
        "deleted.background": "{{colors.error_container.default.hex}}",
        "deleted.border": "{{colors.error.default.hex}}",
        "error": "{{colors.error.default.hex}}",
        "error.background": "{{colors.error_container.default.hex}}",
        "error.border": "{{colors.error.default.hex}}",
        "hidden": "{{colors.on_surface_variant.default.hex}}",
        "hidden.background": "{{colors.surface.default.hex}}",
        "hidden.border": "{{colors.outline_variant.default.hex}}",
        "hint": "{{colors.tertiary.default.hex}}",
        "hint.background": "{{colors.tertiary_container.default.hex}}",
        "hint.border": "{{colors.tertiary.default.hex}}",
        "ignored": "{{colors.outline.default.hex}}",
        "ignored.background": "{{colors.surface.default.hex}}",
        "ignored.border": "{{colors.outline_variant.default.hex}}",
        "info": "{{colors.tertiary.default.hex}}",
        "info.background": "{{colors.tertiary_container.default.hex}}",
        "info.border": "{{colors.tertiary.default.hex}}",
        "modified": "{{colors.secondary.default.hex}}",
        "modified.background": "{{colors.secondary_container.default.hex}}",
        "modified.border": "{{colors.secondary.default.hex}}",
        "predictive": "{{colors.on_surface_variant.default.hex}}",
        "predictive.background": "{{colors.surface_container.default.hex}}",
        "predictive.border": "{{colors.outline.default.hex}}",
        "renamed": "{{colors.secondary.default.hex}}",
        "renamed.background": "{{colors.secondary_container.default.hex}}",
        "renamed.border": "{{colors.secondary.default.hex}}",
        "success": "{{colors.primary.default.hex}}",
        "success.background": "{{colors.primary_container.default.hex}}",
        "success.border": "{{colors.primary.default.hex}}",
        "unreachable": "{{colors.outline.default.hex}}",
        "unreachable.background": "{{colors.surface.default.hex}}",
        "unreachable.border": "{{colors.outline_variant.default.hex}}",
        "warning": "{{colors.error.default.hex}}",
        "warning.background": "{{colors.error_container.default.hex}}",
        "warning.border": "{{colors.error.default.hex}}",
        "players": [
          {
            "cursor": "{{colors.primary.default.hex}}",
            "background": "{{colors.primary.default.hex}}",
            "selection": "{{colors.primary_container.default.hex}}"
          }
        ],
        "syntax": {
          "attribute":              { "color": "#7dcfff", "font_style": "italic" },
          "boolean":                { "color": "#ff9e64", "font_weight": 700 },
          "comment":                { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": "italic" },
          "comment.doc":            { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": "italic" },
          "constant":               { "color": "#ff9e64", "font_weight": 700 },
          "constructor":            { "color": "#7dcfff" },
          "embedded":               { "color": "{{colors.on_surface.default.hex}}" },
          "emphasis":               { "color": "#f7768e", "font_style": "italic" },
          "emphasis.strong":        { "color": "#f7768e", "font_weight": 700 },
          "enum":                   { "color": "#7dcfff" },
          "function":               { "color": "#7aa2f7" },
          "function.method":        { "color": "#7aa2f7" },
          "hint":                   { "color": "{{colors.on_surface_variant.default.hex}}" },
          "keyword":                { "color": "#bb9af7", "font_weight": 700 },
          "label":                  { "color": "#bb9af7" },
          "link_text":              { "color": "#7aa2f7", "font_style": "italic" },
          "link_uri":               { "color": "#7dcfff" },
          "number":                 { "color": "#ff9e64" },
          "operator":               { "color": "#89ddff" },
          "predictive":             { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "preproc":                { "color": "#bb9af7" },
          "primary":                { "color": "{{colors.on_surface.default.hex}}" },
          "property":               { "color": "#7dcfff" },
          "punctuation":            { "color": "{{colors.on_surface.default.hex}}" },
          "punctuation.bracket":    { "color": "{{colors.on_surface.default.hex}}" },
          "punctuation.delimiter":  { "color": "{{colors.on_surface.default.hex}}" },
          "punctuation.list_marker":{ "color": "#bb9af7", "font_weight": 700 },
          "punctuation.special":    { "color": "#f7768e" },
          "string":                 { "color": "#9ece6a" },
          "string.escape":          { "color": "#f7768e", "font_weight": 700 },
          "string.regex":           { "color": "#e0af68" },
          "string.special":         { "color": "#f7768e" },
          "tag":                    { "color": "#7aa2f7", "font_weight": 700 },
          "text.literal":           { "color": "#9ece6a" },
          "title":                  { "color": "#bb9af7", "font_weight": 700 },
          "type":                   { "color": "#2ac3de" },
          "type.builtin":           { "color": "#2ac3de", "font_weight": 700 },
          "variable":               { "color": "{{colors.on_surface.default.hex}}" },
          "variable.special":       { "color": "#f7768e", "font_style": "italic" },
          "variant":                { "color": "#7dcfff" }
        }
      }
    }
  ]
}
